//Added .env.example file to the API folder to provide a template for environment variables needed for the API server configuration.
//should be copied to a .env file and filled with appropriate values before running the server.

PORT=3443
JWT_SECRET=a-long-secret-key-that-should-be-kept-private-and-not-committed-to-version-control-that-is-no-shorter-than-32-characters
JWT_EXPIRES_IN=1h

USE_HTTP2=true

# Paths to the local SSL cert/key (see certs/README.md)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
